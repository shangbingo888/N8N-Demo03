  "name": "[Webhook] 文字→DeepSeek文案→Mimo语音",
  "description": null,
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "text-to-speech",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "接收文本Prompt",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "webhookId": "94f5e07b-7bbb-42ea-924c-f964fffcdd1d"
    },
    {
      "parameters": {
        "jsCode": "// 从 DeepSeek 响应中提取文案\nconst deepseekResponse = $input.first().json;\nconst copywriting = deepseekResponse.choices[0].message.content;\n\n// 构造 Mimo TTS API 请求体\nconst mimoBody = {\n  model: \"mimo-v2.5-tts\",\n  messages: [\n    {\n      role: \"user\",\n      content: \"用温柔亲切的语调朗读，语速适中，像在和朋友聊天一样自然\"\n    },\n    {\n      role: \"assistant\",\n      content: copywriting\n    }\n  ],\n  audio: {\n    format: \"wav\",\n    voice: \"冰糖\"\n  },\n  stream: false\n};\n\nreturn [{\n  json: {\n    mimoBody: mimoBody,\n    copywriting: copywriting,\n    mimoBodyString: JSON.stringify(mimoBody)\n  }\n}];"
      },
      "id": "build-mimo-body",
      "name": "构造Mimo请求体",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        512,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.xiaomimimo.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "={{ $env.MIMO_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 120000
        }
      },
      "id": "call-mimo-tts",
      "name": "调用Mimo语音合成",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        752,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// 从 Mimo 响应中提取 Base64 音频数据\nconst mimoResponse = $input.first().json;\nconst base64Audio = mimoResponse.choices[0].message.audio.data;\n\n// 将 Base64 字符串解码为二进制 Buffer\nconst audioBuffer = Buffer.from(base64Audio, 'base64');\n\n// 输出二进制数据\nreturn [{\n  json: {\n    audioSize: audioBuffer.length,\n    format: 'wav'\n  },\n  binary: {\n    data: {\n      data: audioBuffer.toString('base64'),\n      mimeType: 'audio/wav',\n      fileName: 'speech.wav'\n    }\n  }\n}];"
      },
      "id": "decode-base64",
      "name": "Base64解码为二进制",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1008,
        0
      ]
    },
    {
      "parameters": {
        "fileName": "=/data/audio/speech_{{ $now.format('yyyyMMdd_HHmmss') }}.wav",
        "options": {}
      },
      "id": "save-audio-file",
      "name": "保存音频文件",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        1264,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
