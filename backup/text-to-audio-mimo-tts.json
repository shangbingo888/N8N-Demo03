            },
            "id": "webhook-trigger",
            "name": "\u63a5\u6536\u6587\u672c\u8f93\u5165",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2.1,
            "position": [
                256,
                304
            ],
            "webhookId": "06a01fe7-c8be-4af4-af95-3a01c7e14318"
        },
        {
            "id": "mimo-http-request",
            "name": "\u8bf7\u6c42 Mimo TTS API",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                600,
                300
            ],
            "parameters": {
                "method": "POST",
                "url": "https://api.xiaomimimo.com/v1/chat/completions",
                "authentication": "genericCredentialType",
                "sendBody": true,
                "contentType": "raw",
                "rawContentType": "application/json",
                "body": "={\n  \"model\": \"mimo-v2.5-tts\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"\u7528\u81ea\u7136\u4eb2\u5207\u7684\u8bed\u6c14\u64ad\u62a5\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"{{ $json.body.text }}\"\n    }\n  ],\n  \"audio\": {\n    \"format\": \"wav\",\n    \"voice\": \"{{ $json.body.voice || '\u51b0\u7cd6' }}\"\n  },\n  \"stream\": false\n}",
                "options": {}
            }
        },
        {
            "id": "mimo-decode",
            "name": "Base64 \u89e3\u7801\u4e3a\u97f3\u9891\u6587\u4ef6",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                980,
                300
            ],
            "parameters": {
                "jsCode": "// Mimo TTS \u8fd4\u56de Base64 WAV \u2192 \u89e3\u7801\u4e3a\u4e8c\u8fdb\u5236\nconst items = [];\n\nfor (const item of $input.all()) {\n  const choice = item.json?.choices?.[0];\n  const audioData = choice?.message?.audio?.data;\n  \n  if (!audioData) {\n    throw new Error(\n      'Mimo TTS \u8fd4\u56de\u5f02\u5e38: ' + \n      JSON.stringify(item.json).substring(0, 300)\n    );\n  }\n  \n  const inputText = $('\u63a5\u6536\u6587\u672c\u8f93\u5165').first().json.body.text;\n  \n  items.push({\n    json: {\n      inputText: inputText,\n      voice: $('\u63a5\u6536\u6587\u672c\u8f93\u5165').first().json.body.voice || '\u51b0\u7cd6',\n      status: 'success',\n      textLength: inputText.length\n    },\n    binary: {\n      data: {\n        data: Buffer.from(audioData, 'base64'),\n        mimeType: 'audio/wav',\n        fileName: 'mimo-tts-output.wav'\n      }\n    }\n  });\n}\n\nreturn items;"
            }
        },
        {
            "parameters": {
                "fileName": "/tmp/n8n-mimo-tts.wav",
                "options": {}
            },
            "id": "save-file",
            "name": "\u4fdd\u5b58\u97f3\u9891\u6587\u4ef6",
