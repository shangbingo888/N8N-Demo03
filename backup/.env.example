# ============================================================
# N8N 视频生成流水线 - API Key 配置
# ============================================================
# 使用方法:
#   1. 复制此文件为 .env:  cp .env.example .env
#   2. 填入你的实际 API Key
#   3. n8n 中通过 {{ $env.KEY_NAME }} 引用
#
# ⚠️ .env 文件不要提交到 Git（已在 .gitignore 中排除）
# ============================================================

# ---------- 文生图 API ----------
# Agnes AI 图像生成 (agnes-image-2.1-flash)
# 获取地址: https://platform.agnes-ai.com → Settings → API Keys
# 端点: POST https://apihub.agnes-ai.com/v1/images/generations
# 认证: Bearer Token
AGNES_API_KEY=sk-h3HnU71SAY7940vlySUlFDkhBEy0VRmgnLuoV55sDzydpjl9

# ---------- 文生音频 API ----------
# Mimo TTS (mimo-v2.5-tts)
# 获取地址: https://platform.xiaomimimo.com
# 端点: POST https://api.xiaomimimo.com/v1/chat/completions
# 认证: Header api-key
MIMO_API_KEY=sk-cpik7w6aqpbth1gltgj58cnrxw2fl9o6irvovkxyxol3j4g8

# ---------- AI 文本分析 API ----------
# OpenAI 兼容接口 (用于内容分析/分镜脚本生成)
# 可使用 Agnes AI 文本模型、DeepSeek、OpenAI 等
# 端点: https://apihub.agnes-ai.com/v1 或其他兼容端点
OPENAI_API_KEY=sk-h3HnU71SAY7940vlySUlFDkhBEy0VRmgnLuoV55sDzydpjl9
OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
