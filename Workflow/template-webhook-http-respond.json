{
  "name": "[Template] Webhook → Code → HTTP → Code → Respond",
  "nodes": [
    {
      "id": "wh",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "my-webhook",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "build",
      "name": "Build Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [600, 300],
      "parameters": {
        "jsCode": "// TODO: 构造 API 请求体\n// 输入: $input.first().json.body\n// 输出: { json: {...} }\n\nreturn [{ json: {} }];"
      }
    },
    {
      "id": "http",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [950, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.example.com/endpoint",
        "sendHeaders": true,
        "headerParameters": { "parameters": [] },
        "sendBody": true,
        "contentType": "raw",
        "body": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
      "id": "decode",
      "name": "Decode Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1300, 300],
      "parameters": {
        "jsCode": "// TODO: 处理 API 响应\n// 输入: $input.first().json\n// 输出: { json: {...}, binary: { data: { data: Buffer, mimeType, fileName } } }\n\nreturn [{ json: {} }];"
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1650, 300],
      "parameters": {
        "respondWith": "binary",
        "inputFieldName": "data"
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Build Request", "type": "main", "index": 0 }]] },
    "Build Request": { "main": [[{ "node": "HTTP Request", "type": "main", "index": 0 }]] },
    "HTTP Request": { "main": [[{ "node": "Decode Response", "type": "main", "index": 0 }]] },
    "Decode Response": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "saveManualExecutions": true }
}
