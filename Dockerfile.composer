FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY scripts/video-composer.py /app/

ENV COMPOSER_PORT=8899
ENV COMPOSER_OUTPUT_DIR=/files

EXPOSE 8899

CMD ["python3", "/app/video-composer.py"]
